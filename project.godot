; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="studio sim"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://c2dm0vx6wbeg1"
config/icon="uid://ch1yuq51ghyde"

[audio]

buses/SFX/solo=false
buses/SFX/mute=false
buses/SFX/bypass_fx=false
buses/SFX/volume_db=0.0
buses/SFX/send="Master"
buses/Music/solo=false
buses/Music/mute=false
buses/Music/bypass_fx=false
buses/Music/volume_db=0.0
buses/Music/send="Master"

[autoload]

CameraManager="*res://scripts/CameraManager.gd"
PaintingModeManager="*res://scripts/painting/PaintingModeManager.gd"
SteamManager="*res://scripts/SteamManager.gd"
MissionManager="*res://scripts/MissionManager.gd"
UIManager="*res://scripts/UIManager.gd"
PaintingSpawner="*res://scripts/PaintingSpawner.gd"
DebugPaintingConverter="*res://scripts/DebugPaintingConverter.gd"
ValidationDebugOverlay="*res://scenes/UI/ValidationDebugOverlay.tscn"
SceneTransition="*res://scripts/SceneTransition.gd"
WorldStateManager="*res://scripts/WorldStateManager.gd"
EconomyManager="*res://scripts/economy/EconomyManager.gd"
ShopManager="*res://scripts/economy/ShopManager.gd"
ReputationManager="*res://scripts/economy/ReputationManager.gd"
StyleTracker="*res://scripts/economy/StyleTracker.gd"
AutomationManager="*res://scripts/economy/AutomationManager.gd"
ValidationLoadingOverlay="*res://scenes/UI/ValidationLoadingOverlay.tscn"
AudioManager="*res://scripts/AudioManager.gd"
InputDeviceManager="*res://scripts/InputDeviceManager.gd"
DebugLogger="*res://scripts/DebugLogger.gd"
InputValidator="*res://scripts/InputValidator.gd"
ControllerMapper="*res://scripts/ControllerMapper.gd"
SteamInput="*res://scripts/SteamInput.gd"
ControllerDebugOverlay="*res://scripts/ControllerDebugOverlay.gd"
LaunchOptionsHandler="*res://scripts/LaunchOptionsHandler.gd"
PaintingExporter="*res://scripts/PaintingExporter.gd"
GalleryUploader="*res://scripts/GalleryUploader.gd"
LocaleManager="*res://scripts/LocaleManager.gd"
StickerLibrary="*res://scripts/painting/StickerLibrary.gd"
SkinLibrary="*res://scripts/SkinLibrary.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="fps"

